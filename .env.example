# =============================================================================
# Sawwi — environment configuration
# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored; this .env.example IS committed. Never commit real secrets.
# =============================================================================

# --- App ---------------------------------------------------------------------
NODE_ENV=production
# Port the Next server listens on inside the container (Caddy proxies to it).
PORT=3000
# Root domain. Dashboard = app.<ROOT_DOMAIN>; published sites = {slug}.<ROOT_DOMAIN>
ROOT_DOMAIN=sawwi.com
# Public base URL of the dashboard (absolute links, Better Auth callbacks).
NEXT_PUBLIC_APP_URL=http://localhost

# --- Database (PostgreSQL) ---------------------------------------------------
# These three are consumed by the postgres container on first boot.
POSTGRES_USER=sawwi
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=sawwi
# Prisma connection string. Host = the compose service name `postgres`.
# From the host (e.g. running `prisma migrate` locally) use localhost:5432 instead.
DATABASE_URL=postgresql://sawwi:change-me-strong-password@postgres:5432/sawwi?schema=public

# --- Redis (queues/cache) ----------------------------------------------------
# Host = the compose service name `redis`. From the host use localhost:6379.
REDIS_URL=redis://redis:6379

# --- Email (SMTP) ------------------------------------------------------------
# Dev: local Mailpit (read mail at http://localhost:8025). Prod: real provider.
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=Sawwi <no-reply@sawwi.local>

# --- Auth (Better Auth) ------------------------------------------------------
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost

# --- Object storage (local MinIO now; Cloudflare R2 later — both S3-compatible)
# LOCAL (MinIO via compose): the values below work out of the box.
# PRODUCTION (R2): set R2_ACCOUNT_ID, point R2_ENDPOINT at the R2 S3 API, use the
# R2 access keys, and set R2_PUBLIC_URL to your media domain. No code changes.
MINIO_ROOT_USER=sawwi
MINIO_ROOT_PASSWORD=sawwiMinioLocalDevSecret
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=sawwi
R2_SECRET_ACCESS_KEY=sawwiMinioLocalDevSecret
R2_BUCKET=sawwi-media
# S3 API endpoint. Local MinIO: http://minio:9000 (containers) /
# http://127.0.0.1:9000 (host dev). R2: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=http://minio:9000
# Public base for served media. Local MinIO: http://localhost:9000/sawwi-media.
# R2: https://media.sawwi.com
R2_PUBLIC_URL=http://localhost:9000/sawwi-media

# --- Internal secrets --------------------------------------------------------
# Shared secret protecting internal/cron route handlers (expiry sweep, analytics flush).
# Generate: openssl rand -base64 32
CRON_SECRET=replace-with-openssl-rand-base64-32

# DEV ONLY — set to "true" locally (usually in .env.local) to let the
# `x-sawwi-user` header identify the user until Better Auth is wired. Leave
# unset in production.
# ALLOW_DEV_AUTH=true

# --- Caddy / TLS (LATER PHASE — leave blank for now) -------------------------
# Cloudflare API token for wildcard *.sawwi.com DNS-01 TLS. Unused until enabled.
CF_API_TOKEN=
