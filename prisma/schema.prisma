// Sawwi — core domain model (Milestone 2).
// See AGENT_GUIDE.md §4 and docs/PRD.md §4 for the authoritative rules.
// Prisma 7: the new engine-free `prisma-client` generator (client emitted to src/generated).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL lives in prisma.config.ts (migrations) and is
  // passed to PrismaClient via a driver adapter at runtime (see src/lib/db.ts).
}

// ============================================================================
// Enums
// ============================================================================

/// Platform-wide flag. Everything else is contextual (workspace/site scoped).
enum PlatformRole {
  user
  admin
}

enum MemberRole {
  owner
  member
}

/// A workspace is either a reseller's book of client sites, or a single
/// admin-provisioned free "direct" business. Drives caps, nav, and expiry source.
enum WorkspaceKind {
  reseller
  direct
}

/// Admin-controlled lifecycle of a recorded (offline) payment. Independent of
/// the platform commission owed on it (see CommissionStatus).
enum PaymentStatus {
  pending
  paid
  checked
  stopped
  refunded
}

enum AccessLevel {
  editor
  viewer
}

enum SiteLanguage {
  ar
  en
}

/// Stored site lifecycle. `grace` is billing-derived (see Subscription) and is
/// NOT stored here — a live site is `published`; billing decides if it's served.
enum SiteStatus {
  draft
  published
  suspended
}

enum SubscriptionStatus {
  active
  grace
  suspended
}

enum PaymentMethod {
  cash
  mobile_money
  bank_transfer
  other
}

/// Keep in sync with src/shared/currency.ts CURRENCIES (the single source).
enum Currency {
  SYP
  SYP_NEW
  USD
  EUR
  TRY
}

enum CommissionStatus {
  owed
  settled
}

/// Lifecycle of a lead/message a visitor submits through a published site's
/// contact form. Owners triage from the dashboard inbox.
enum SiteMessageStatus {
  unread
  read
  archived
}

/// The two verticals of the marketplace template. A single site can list both.
enum ListingVertical {
  car
  home
}

/// End-user role on a PUBLISHED site (distinct from the platform's PlatformRole).
/// manager = delegated site admin · contributor = manages their own content (e.g.
/// posts ads) · member = registered visitor. New signups default to `member`;
/// display labels are owner-customizable per site (SiteSettings.roleLabels).
enum SiteUserRole {
  manager
  contributor
  member
}

// ============================================================================
// Identity
// NOTE: provisional. Better Auth will own the auth tables (Session/Account/
// Verification) and may reconcile this User shape via its CLI. Fields here
// match Better Auth conventions so migration is low-friction. See src/lib/auth.ts.
// ============================================================================

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String?
  emailVerified Boolean      @default(false)
  image         String?
  platformRole  PlatformRole @default(user)
  /// Direct-tier hard expiry: an admin-provisioned free owner's site is served
  /// while `now < endDate` (null = never expires). Ignored for reseller sites,
  /// whose expiry lives on the Subscription.
  endDate       DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  memberships       WorkspaceMember[]
  siteAccess        SiteAccess[]
  sessions          Session[]
  accounts          Account[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

/// A browser Web Push subscription for a platform User (PWA notifications). One
/// row per browser/device endpoint; `endpoint` is globally unique. Created when
/// the user enables notifications, deleted on unsubscribe or when a send returns
/// 404/410 (expired). Cascades away with the user.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String // client public key (from the browser subscription)
  auth      String // client auth secret
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ---- Better Auth tables (managed by Better Auth via src/lib/auth.ts) --------

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ============================================================================
// Workspace & access
// ============================================================================

model Workspace {
  id              String        @id @default(cuid())
  name            String
  kind            WorkspaceKind @default(reseller)
  commissionPct   Float         @default(0)
  status          String        @default("active")
  /// Shown to site-scoped business owners as the "contact your provider" target
  /// on the expiry banner/tab (the reseller who sold them the site).
  contactName     String?
  contactWhatsapp String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  members     WorkspaceMember[]
  invites     WorkspaceInvite[]
  sites       Site[]
  commissions CommissionEntry[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String     @id @default(cuid())
  workspaceId String
  userId      String
  role        MemberRole @default(member)
  joinedAt    DateTime   @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  token       String    @unique
  createdBy   String
  expiresAt   DateTime // 72h from creation (enforced in app)
  usedBy      String?
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("workspace_invites")
}

// ============================================================================
// Site
// ============================================================================

model Site {
  id              String       @id @default(cuid())
  workspaceId     String
  slug            String       @unique // validated [a-z0-9-]{3,40}, see src/server/slug.ts
  businessName    String
  verticalKey     String // e.g. "barbershop"
  templateKey     String?
  language        SiteLanguage @default(ar)
  status          SiteStatus   @default(draft)
  /// Admin/reseller "pause": when true the public domain serves the branded
  /// holding page instead of the site, even if published. Drafts show the same
  /// page automatically (served from minute 0 until first publish).
  maintenanceMode Boolean      @default(false)
  logoUrl         String? // uploaded logo/avatar — shown in the dashboard list and the site header
  seo             Json         @default("{}") // site-wide SEO defaults, see src/shared/seo.ts
  content         Json         @default("{}") // editable template data (see src/templates); merged over the template defaults at render
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  settings      SiteSettings?
  theme         SiteTheme?
  subscription  Subscription?
  access        SiteAccess[]
  services      Service[]
  team          TeamMember[]
  testimonials  Testimonial[]
  faq           FaqItem[]
  snapshots     PublishSnapshot[]
  messages      SiteMessage[]
  notifications Notification[]
  listings      Listing[]
  siteUsers     SiteUser[]
  visits        SiteVisit[]
  submissions   Submission[]
  providers     Provider[]
  customers     Customer[]

  @@index([workspaceId])
  @@map("sites")
}

/// A public form submission on a Shaghleh-style marketplace site. PROVIDER and
/// CUSTOMER share this one table (separated by `kind`) so there is a single inbox
/// and one set of admin screens. Scoped to the site; unauthenticated visitors
/// create these via POST /api/sites/[siteId]/submissions. We store the raw phone
/// exactly as typed AND a normalized form used for duplicate detection — and
/// nothing beyond the declared fields (no IP, no user-agent, no fingerprinting).
model Submission {
  id         String           @id @default(cuid())
  siteId     String
  kind       SubmissionKind
  status     SubmissionStatus @default(NEW)
  name       String
  phone      String // normalized E.164, e.g. +9639XXXXXXXX
  phoneRaw   String // exactly as the visitor typed it
  category   String
  area       String
  details    String? // portfolio link (provider) or job details (customer)
  /// Uploaded image URLs (e.g. a provider's work samples). Public-form uploads go
  /// through the site-scoped, rate-limited submissions upload endpoint (≤2MB each).
  images     String[]         @default([])
  adminNote  String?
  /// How it arrived: "web" (the public form) or "manual" (a collaborator entered
  /// someone who replied on WhatsApp). One list, not a form list + a chat history.
  source     String           @default("web")
  /// utm_source from the landing URL, if present. The ONLY visitor attribution we
  /// keep — no IP, no user-agent, no fingerprinting.
  utmSource  String?
  /// Lightweight status audit: which platform user last changed the status, when.
  statusById String?
  statusAt   DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, kind, status, createdAt])
  @@index([siteId, phone])
  @@map("submissions")
}

enum SubmissionKind {
  PROVIDER
  CUSTOMER
}

enum SubmissionStatus {
  NEW
  REVIEWING
  ACCEPTED
  REJECTED
  CONTACTED
}

/// A vetted service provider (حرفي/مستقل) on a marketplace site. Built now but kept
/// dark: public profiles only render once `SiteSettings.publicProfilesEnabled` is on
/// AND the provider opts in AND is ACTIVE+verified (see src/server/providers/visibility).
/// `phone`/`phoneRaw` are internal and NEVER serialized publicly. Rating aggregates
/// are denormalized and recomputed in-transaction after every Job/Rating write.
model Provider {
  id            String         @id @default(cuid())
  siteId        String
  submissionId  String?        @unique // promoted from a Submission (PROVIDER, ACCEPTED)
  slug          String // URL slug, unique per site
  name          String // internal, real name
  displayName   String? // public, may be "أبو محمد"
  phone         String // normalized E.164, NEVER public
  phoneRaw      String
  categories    String[] // from site config, not hardcoded
  areas         String[]
  bio           String? // max 400 chars
  status        ProviderStatus @default(DRAFT)
  verifiedAt    DateTime?
  profilePublic Boolean        @default(false) // per-provider opt-in

  jobsCompleted Int      @default(0) // denormalized, recomputed
  ratingCount   Int      @default(0)
  ratingSum     Int      @default(0)
  ratingAvg     Decimal? @db.Decimal(3, 2)

  internalNote String? // private quality notes, never public
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  site   Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  jobs   Job[]
  photos ProviderPhoto[]

  @@unique([siteId, slug])
  @@index([siteId, status])
  @@map("providers")
}

model ProviderPhoto {
  id         String   @id @default(cuid())
  providerId String
  key        String // R2 object key (not a full URL)
  caption    String?
  sortOrder  Int      @default(0)
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, sortOrder])
  @@map("provider_photos")
}

/// A brokered match between a provider and a customer. Recorded by hand from day one
/// so ratings always trace back to a real job. `customerPhone` is internal, never public.
model Job {
  id                   String    @id @default(cuid())
  siteId               String
  providerId           String
  customerId           String? // the picked Customer (approved list); name/phone kept denormalized for history
  customerSubmissionId String? // if the customer arrived via a form
  customerName         String
  customerPhone        String // normalized, NEVER public
  category             String
  area                 String
  description          String?
  status               JobStatus @default(MATCHED)
  matchedAt            DateTime  @default(now())
  completedAt          DateTime?
  followedUpAt         DateTime? // the follow-up call actually happened
  createdByUserId      String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  provider Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  rating   Rating?

  @@index([siteId, status, matchedAt])
  @@index([providerId, status])
  @@index([customerId])
  @@map("jobs")
}

/// A single rating for a COMPLETED, followed-up Job. There is NO public endpoint that
/// creates one — only an authenticated collaborator recording a follow-up result.
/// `publicComment` renders only when `commentApproved`. `privateNote` is never public.
model Rating {
  id               String       @id @default(cuid())
  siteId           String
  jobId            String       @unique // one rating per job, enforced by DB + service
  providerId       String
  score            Int // 1..5
  publicComment    String? // max 200 chars, only rendered if approved
  commentApproved  Boolean      @default(false)
  privateNote      String? // never rendered publicly
  source           RatingSource
  recordedByUserId String
  recordedAt       DateTime     @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([providerId, recordedAt])
  @@map("ratings")
}

/// A customer in the brokered-services flow — the demand side mirror of Provider.
/// Promoted from an ACCEPTED customer Submission (same approve flow as providers),
/// then picked when recording a match. name/phone are INTERNAL, never public.
model Customer {
  id           String         @id @default(cuid())
  siteId       String
  submissionId String?        @unique // promoted from a Submission (CUSTOMER, ACCEPTED)
  name         String
  phone        String // normalized E.164, internal — never public
  phoneRaw     String
  area         String? // where they are (from the submission), used to prefill a match
  status       CustomerStatus @default(DRAFT)
  internalNote String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  site Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  jobs Job[]

  @@index([siteId, status])
  @@map("customers")
}

enum CustomerStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProviderStatus {
  DRAFT
  ACTIVE
  PAUSED
  REMOVED
}

enum JobStatus {
  MATCHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum RatingSource {
  FOLLOW_UP_CALL
  WHATSAPP
  IN_PERSON
}

/// One counted visit to a published site, keyed by BROWSER SESSION: each new
/// session (a fresh `sawwi_vid` session cookie) counts once per site. The unique
/// (siteId, sessionKey) makes recording idempotent — repeat pageviews in the same
/// session don't recount — so the per-site total is just COUNT(*). Cascades away
/// with the site.
model SiteVisit {
  id         String   @id @default(cuid())
  siteId     String
  sessionKey String // opaque per-browser-session id (from the sawwi_vid cookie)
  createdAt  DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  // One visit per (site, session); (siteId) backs the count.
  @@unique([siteId, sessionKey])
  @@index([siteId])
  @@map("site_visits")
}

/// An END-USER account on a published site (a customer/seller of the tenant's
/// website) — completely separate from the platform `User` (dashboard identity).
/// Scoped per site; email is unique within a site. Password is a scrypt hash
/// (salt:hash). Sessions are opaque tokens in `SiteUserSession`.
model SiteUser {
  id           String       @id @default(cuid())
  siteId       String
  email        String
  name         String?
  /// Optional contact phone/WhatsApp the user manages in their account settings;
  /// prefills the enquiry + contact forms. Nullable → existing rows unaffected.
  phone        String?
  passwordHash String
  role         SiteUserRole @default(member)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  site     Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  sessions SiteUserSession[]
  listings Listing[]

  @@unique([siteId, email])
  @@index([siteId])
  @@map("site_users")
}

/// A site-user session — the cookie holds only `token`; everything else is
/// server-side. `siteId` is denormalized so a session is validated against the
/// site it was minted for (defense-in-depth on top of host-only cookie scoping).
model SiteUserSession {
  id         String   @id @default(cuid())
  siteUserId String
  siteId     String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  siteUser SiteUser @relation(fields: [siteUserId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([siteUserId])
  @@map("site_user_sessions")
}

/// A marketplace listing (a car or a home) the site OWNER publishes. Unlike
/// ordinary template content (frozen in a PublishSnapshot), listings are served
/// LIVE from this table — a dealer/agency adds and removes them daily, so there
/// is no "publish the whole site" step gating them.
///
/// The physical shape is fixed (human-controlled + CI-migrated); the per-vertical
/// FIELD set is defined in the template module and stored in `specs` (JSON), so
/// the marketplace can grow new fields without a migration (see the generative-
/// architecture direction). Hot filter/sort keys are promoted to columns.
model Listing {
  id               String          @id @default(cuid())
  siteId           String
  vertical         ListingVertical
  title            String
  price            Float? // integer amount; render applies currency + separators. null = "on request"
  offer            String? // homes: "rent" | "buy" (a filter); null for cars
  place            String? // city / area — a filter + shown on the card
  description      String?
  images           Json            @default("[]") // string[] of storage URLs; first = cover
  features         Json            @default("[]") // string[] extras (the `multi` filter)
  specs            Json            @default("{}") // all other vertical fields, keyed by field key
  published        Boolean         @default(false)
  /// Merchandising/monetization lever: featured listings sort first and show a
  /// "مميّز" badge — the dealer's way to push high-margin stock (or a paid boost).
  featured         Boolean         @default(false)
  /// available | reserved | sold — keeps the showroom credible + creates urgency.
  status           String          @default("available")
  /// The site-user (seller/contributor) who authored this listing, when posted
  /// on-site. null = owner-authored from the dashboard. onDelete SetNull so
  /// removing a seller account never deletes their listings.
  authorSiteUserId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  site   Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  author SiteUser? @relation(fields: [authorSiteUserId], references: [id], onDelete: SetNull)

  @@index([siteId, vertical, published])
  @@index([siteId, createdAt])
  @@index([siteId, authorSiteUserId])
  @@map("listings")
}

/// A lead captured from a published site's public contact form. Append-only
/// from the visitor's side; the owner only changes `status` (read/archived) or
/// deletes. No account is required to submit — anti-abuse is enforced in the
/// service (honeypot + per-IP rate limit); `ipHash` is a coarse, non-PII signal.
model SiteMessage {
  id        String            @id @default(cuid())
  siteId    String
  name      String
  contact   String? // phone / WhatsApp / email — free text, optional
  body      String
  status    SiteMessageStatus @default(unread)
  ipHash    String? // sha256(ip)[:16] — abuse signal only, not stored PII
  createdAt DateTime          @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, status])
  @@index([siteId, createdAt])
  @@map("site_messages")
}

/// A per-user in-app notification (dashboard bell). Created as a best-effort
/// side effect of an event — e.g. a visitor sends a message → every user who can
/// see that site (workspace members + accepted collaborators) gets one. Read /
/// cleared from the bell. Cascades away with the user or the related site.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // event kind, e.g. "site_message"
  title     String
  body      String?
  siteId    String? // context for grouping / navigation
  link      String? // dashboard path opened on click
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site? @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// Site-scoped invite: how a business owner edits ONLY their one site.
model SiteAccess {
  id            String      @id @default(cuid())
  siteId        String
  userId        String? // null until the invite is accepted
  invitedEmail  String
  level         AccessLevel @default(editor)
  builderAccess Boolean     @default(false) // editors edit settings; builder (pages/sections) + publish require this
  token         String?     @unique // invite-accept link; consumed on accept (mirrors WorkspaceInvite)
  invitedBy     String
  acceptedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime    @default(now())

  site Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([siteId])
  @@index([userId])
  @@map("site_access")
}

model SiteSettings {
  id                    String  @id @default(cuid())
  siteId                String  @unique
  whatsappNumber        String?
  phone                 String?
  socials               Json    @default("{}")
  googleMapsUrl         String?
  address               String?
  openingHours          Json    @default("{}") // structured, see src/server/hours.ts
  currency              String  @default("SYP") // site-wide price currency, see src/shared/currency.ts
  logoMediaId           String?
  loadingIconId         String?
  /// End-user auth: when true the published site shows sign-in/up and accepts
  /// SiteUser accounts. Off by default so existing sites are unchanged.
  authEnabled           Boolean @default(false)
  /// Owner's custom display labels for the 3 SiteUserRole values, e.g.
  /// { "manager": "مدير", "contributor": "بائع", "member": "زبون" }.
  roleLabels            Json    @default("{}")
  /// Master switch for public provider profiles (/p/[slug]). Off by default: while
  /// false every public profile route 404s. Reveal only once there is real job
  /// history behind the ratings. See src/server/providers/visibility.ts.
  publicProfilesEnabled Boolean @default(false)

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("site_settings")
}

model SiteTheme {
  id             String  @id @default(cuid())
  siteId         String  @unique
  paletteKey     String? // curated palette key
  primaryColor   String?
  secondaryColor String?
  bgColor        String?
  fontKey        String  @default("readex")
  headerVariant  String? // universal header layout: A|B|C
  headerScheme   String? // header color scheme: light|dark|glass
  footerVariant  String? // universal footer layout: A|B|C
  footerScheme   String? // footer color scheme: dark|light|accent

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@map("site_themes")
}

// ============================================================================
// Structured content (reused across sections)
// ============================================================================

model Service {
  id           String  @id @default(cuid())
  siteId       String
  name         String
  description  String?
  price        String? // free text, e.g. "من 5000 ل.س"
  duration     String?
  imageMediaId String?
  order        Int     @default(0)
  visible      Boolean @default(true)

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("services")
}

model TeamMember {
  id           String  @id @default(cuid())
  siteId       String
  name         String
  roleTitle    String?
  photoMediaId String?
  order        Int     @default(0)

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("team_members")
}

model Testimonial {
  id     String @id @default(cuid())
  siteId String
  author String
  text   String
  order  Int    @default(0)

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("testimonials")
}

model FaqItem {
  id       String @id @default(cuid())
  siteId   String
  question String
  answer   String
  order    Int    @default(0)

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@map("faq_items")
}

// ============================================================================
// Publishing
// ============================================================================

/// Immutable full-site payload; append-only history. Rollback = new snapshot
/// copying an old payload.
model PublishSnapshot {
  id        String   @id @default(cuid())
  siteId    String
  version   Int
  payload   Json
  authorId  String?
  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, version])
  @@index([siteId])
  @@map("publish_snapshots")
}

// ============================================================================
// Billing
// ============================================================================

model Subscription {
  id              String             @id @default(cuid())
  siteId          String             @unique
  plan            String             @default("annual")
  price           Float?
  currency        Currency           @default(SYP)
  expiry          DateTime
  status          SubscriptionStatus @default(active)
  /// Smallest renewal-reminder threshold (days) already emailed for the CURRENT
  /// expiry; reset to null whenever expiry is extended. Prevents duplicate sends.
  lastReminderDay Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  site     Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  payments PaymentRecord[]

  @@map("subscriptions")
}

model PaymentRecord {
  id             String        @id @default(cuid())
  subscriptionId String
  amount         Float
  currency       Currency      @default(SYP)
  method         PaymentMethod @default(cash)
  status         PaymentStatus @default(pending) // admin-controlled lifecycle (paid/checked/stopped…)
  payerName      String? // who paid (the client/restaurant), free text
  collectedBy    String? // userId of the reseller who recorded it
  note           String?
  createdAt      DateTime      @default(now())

  subscription Subscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  commission   CommissionEntry?

  @@index([subscriptionId])
  @@map("payment_records")
}

model CommissionEntry {
  id          String           @id @default(cuid())
  workspaceId String
  paymentId   String           @unique
  pct         Float
  amount      Float
  status      CommissionStatus @default(owed)
  createdAt   DateTime         @default(now())
  settledAt   DateTime?

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payment   PaymentRecord @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("commission_entries")
}

/// A lead captured from the public landing page "free preview" form. Not tied to
/// any account — a prospective customer leaves their business name + WhatsApp so
/// an admin can reach out. Created by anyone (public POST); read/managed ONLY
/// from the admin dashboard. New leads notify every platform admin.
model Lead {
  id           String     @id @default(cuid())
  businessName String
  whatsapp     String /// normalized digits incl. country code, e.g. 9639XXXXXXXX
  email        String?
  status       LeadStatus @default(new)
  note         String? /// admin-only internal note
  ipHash       String? /// coarse, non-reversible IP fingerprint — abuse signal only
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([ipHash, createdAt])
  @@map("leads")
}

enum LeadStatus {
  new
  contacted
  converted
  archived
}
